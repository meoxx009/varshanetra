# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables (NEVER commit secrets!)
.env
.env.*
.env*.local
!.env.example

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js telemetry & cache
.next/cache
*.tsbuildinfo
next-env.d.ts

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local test data & databases (NEVER commit stateful data!)
/.data/
/scratch/

# Local media uploads
/public/uploads/field-reports/*
!/public/uploads/field-reports/.gitkeep

# Python cache & local binaries
__pycache__/
*.py[cod]
*$py.class
*.exe

# Supabase CLI temp files
supabase/.temp/


