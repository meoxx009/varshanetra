# ==============================================================================
# VarshaNetra - Environment Variables Configuration Reference
# ==============================================================================
# Local Development: Copy this template to .env.local (which is gitignored).
# Vercel Deployment: Add these in Vercel Dashboard -> Project Settings -> Environment Variables.
#
# IMPORTANT:
# - After setting or modifying variables in Vercel, you MUST trigger a new deployment
#   (or promote a deployment) for build-time and runtime environments to capture them.
# - Do NOT include trailing whitespace or trailing slashes in URLs.
# - NEVER commit secret keys (SUPABASE_SERVICE_ROLE_KEY) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Application Domain
# ------------------------------------------------------------------------------
# Canonical URL of your deployment (e.g., https://varshanetra.vercel.app or http://localhost:3000)
# In Vercel, VERCEL_PROJECT_PRODUCTION_URL is also automatically detected as fallback.
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 2. Supabase Integration (PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
# Found in: Supabase Project Dashboard -> Project Settings -> API
#
# Client-Safe Variables (Baked into browser JavaScript bundles at build time):
# URL of your Supabase project (e.g., https://abcdefghijklmno.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public Anon / Publishable API Key (safe for browser client)
# VarshaNetra supports both traditional JWT anon key and modern sb_publishable_ keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-Only Variables (STRICTLY for Server Components, Route Handlers, and Actions):
# NEVER prefix with NEXT_PUBLIC_. Keep private.
# Enables bypassing RLS for server administrative operations (audit logs, telemetry probes).
SUPABASE_SERVICE_ROLE_KEY=

# Backend Fallbacks (If using the official Vercel-Supabase marketplace integration):
# VarshaNetra automatically resolves SUPABASE_URL and SUPABASE_ANON_KEY if set.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. Weather & Hydrological Telemetry (Open-Meteo)
# ------------------------------------------------------------------------------
# Default: https://api.open-meteo.com/v1 (No API key required for standard usage)
NEXT_PUBLIC_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ------------------------------------------------------------------------------
# 4. OpenStreetMap Nominatim Geocoding
# ------------------------------------------------------------------------------
# OSM Nominatim Usage Policy requires identification with application name and contact email.
NEXT_PUBLIC_NOMINATIM_APP_NAME=VarshaNetra-DisasterWarningSystem
NEXT_PUBLIC_NOMINATIM_CONTACT_EMAIL=admin@varshanetra.local

# ------------------------------------------------------------------------------
# 5. OpenStreetMap Overpass Infrastructure API
# ------------------------------------------------------------------------------
# Default: https://overpass-api.de/api/interpreter
NEXT_PUBLIC_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ------------------------------------------------------------------------------
# 6. Demonstration / Sandbox Mode
# ------------------------------------------------------------------------------
# "true" allows district sandbox session testing when live Supabase is not connected.
# "false" enforces strict live Supabase authentication.
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 7. Twilio SMS Alert Gateway (Server-Only, Never Expose to Client)
# ------------------------------------------------------------------------------
# Free trial gives ~$15 credits (~1000 SMS for testing).
# Sign up at twilio.com to obtain credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 8. NASA Earthdata / GPM IMERG Satellite Rainfall (Server-Only, LIVE-002)
# ------------------------------------------------------------------------------
# Free registration at: https://urs.earthdata.nasa.gov
# Generate user API token under Profile -> Generate Token.
# Authorize "NASA GESDISC DATA ARCHIVE" under Applications -> Authorized Apps.
NASA_EARTHDATA_TOKEN=
NASA_EARTHDATA_USERNAME=

# ------------------------------------------------------------------------------
# 9. ISRO MOSDAC INSAT-3D Satellite Telemetry (Server-Only, LIVE-003)
# ------------------------------------------------------------------------------
# Free registration at: https://mosdac.gov.in
# Generate personal API access token under User Profile -> API Access.
MOSDAC_TOKEN=

# ------------------------------------------------------------------------------
# 10. data.gov.in Official Government Open Data API (Server-Only, LIVE-005)
# ------------------------------------------------------------------------------
# Free registration at: https://data.gov.in/user/register
# Public demo key: 579b464db66ec23bdd000001
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001

# ------------------------------------------------------------------------------
# 11. Tomorrow.io Weather API (Server-Only, SOURCES-002 / VNET-TOMORROW-FINAL-001)
# ------------------------------------------------------------------------------
# Required Environment Variable for Tomorrow.io 1km/1-min hyper-local nowcasting.
# Sign up and generate a free API key at: https://app.tomorrow.io (500 calls/day free tier).
# NEVER expose this key to client components or prefix with NEXT_PUBLIC_.
TOMORROW_API_KEY=


